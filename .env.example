# Vercel/Neon provides this to the deployed app. Add the same connection URL as
# the GitHub Actions repository secret DATABASE_URL for persisted ingestion runs.
DATABASE_URL=

# 32-byte key used to encrypt renewable source/browser sessions before PostgreSQL persistence.
# Generate 32 random bytes and encode them as base64, or use exactly 64 hex characters.
# Configure the same value in Vercel Preview + Production and GitHub Actions. Never commit the real key.
SOURCE_SESSION_ENCRYPTION_KEY=

# Browser-backed source pulls are configured by GitHub Actions. Local values are optional.
BEACON_START_URL=https://www.beaconbid.com/solicitations/city-of-houston/open
BEACON_AGENCY=city-of-houston
BEACON_PERSIST=false

# Legacy temporary path. Once persisted Beacon source connections are wired into document
# ingestion (#69/#70), BEACON_SESSION_COOKIE should no longer be needed for the supported flow.
BEACON_SESSION_COOKIE=
