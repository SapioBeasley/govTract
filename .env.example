# Vercel/Neon provides this to the deployed app. Add the same connection URL as
# the GitHub Actions repository secret DATABASE_URL for persisted ingestion runs.
DATABASE_URL=

# 32-byte key used to encrypt renewable source/browser sessions before PostgreSQL persistence.
# Use either base64 that decodes to exactly 32 bytes or exactly 64 hexadecimal characters.
# Configure the same exact value in Vercel Preview + Production and GitHub Actions. Never commit the real key.
SOURCE_SESSION_ENCRYPTION_KEY=

# Browser-backed source pulls are configured by GitHub Actions. Local values are optional.
BEACON_START_URL=https://www.beaconbid.com/solicitations/city-of-houston/open
BEACON_AGENCY=city-of-houston
BEACON_PERSIST=false

# Protected Beacon documents can require the connected supplier to register as a planholder
# for that solicitation. govTract does this automatically by default using the connected
# Beacon profile, interest=Bidder, and emailDocument=false. Set false only to opt out.
BEACON_AUTO_REGISTER=true

# Solicitation-understanding cost controls. Paid AI is disabled by default: both dollar
# budgets resolve to $0.00 when unset. Increase these only when paid understanding is desired.
GOVTRACT_AI_AUTOMATIC_BUDGET_USD=0
GOVTRACT_AI_MANUAL_BUDGET_USD=0

# Separate, per-click upper budget for manual AI bid drafting. Disabled by default for
# billable accounts. Setting this does NOT enable automatic drafting or regeneration.
# Non-billable model projects may generate manual drafts with the default $0 budget.
GOVTRACT_AI_BID_DRAFT_BUDGET_USD=0

# Deterministic input bounds for solicitation understanding. Adjacent extraction segments are
# packed within a document up to the per-document limit so page-level PDFs do not create a
# provider request per page. These defaults can be overridden without changing application code.
GOVTRACT_AI_UNDERSTANDING_PER_DOCUMENT_CHAR_BUDGET=200000
GOVTRACT_AI_UNDERSTANDING_PER_OPPORTUNITY_CHAR_BUDGET=600000
GOVTRACT_AI_UNDERSTANDING_MAX_CHUNK_CHARS=200000
GOVTRACT_AI_UNDERSTANDING_MAX_OUTPUT_TOKENS_PER_CALL=8192
UNDERSTANDING_GENERATION_LIMIT=25

# Gemini is the first solicitation-understanding provider. Keep the API key only in local env,
# Vercel secrets, or GitHub Actions secrets. Billing mode defaults to billable when omitted,
# which means the $0 govTract budget blocks model calls. Set non_billable only when this
# specific Gemini project/account is intentionally configured for non-billable execution.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_VERSION=
GEMINI_BILLING_MODE=billable

# Provider/model limits and pricing are configuration inputs, not business rules. These values
# reflect the Gemini 3.5 Flash-Lite standard published profile in September 2026 and can be changed
# without code changes when Google changes limits or pricing.
GEMINI_PRICING_PROFILE_VERSION=gemini-3.5-flash-lite-standard-2026-09
GEMINI_INPUT_TOKEN_LIMIT=1048576
GEMINI_OUTPUT_TOKEN_LIMIT=65536
GEMINI_INPUT_COST_USD_PER_MILLION=0.30
GEMINI_OUTPUT_COST_USD_PER_MILLION=2.50
